{
  "repo": "metricsarr",
  "tag_prefix": "",
  "default_branch": "master",
  "remote": "origin",
  "changelog": "docs/CHANGELOG.md",
  "version_attr_regex": null,
  "hub_mode": "external",
  "publish_model": "tag",
  "publish_branch": null,
  "python": "3.12",
  "extra_gates": [],
  "tests_tracked": true,
  "package_dir": "dustarr",
  "plugin_key": "dustarr",
  "zip_name": "Dustarr-{version}.zip",
  "hub_slug": "dustarr",
  "version_files": [
    {
      "path": "dustarr/plugin.json",
      "regex": "\"version\"\\s*:\\s*\"([^\"]+)\""
    },
    {
      "path": "dustarr/plugin.py",
      "regex": "^\\s*PLUGIN_VERSION\\s*=\\s*\"([^\"]+)\""
    }
  ],
  "_note": "Contract read by scripts/*.py, .githooks, .github/workflows and the workspace release, pre-release-qa, deploy-plugin and hub-release skills. Values marked null are unknown or not applicable. Keep keys in this order."
}
